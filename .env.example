# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Só no servidor (NUNCA com prefixo NEXT_PUBLIC_): ignora o RLS para gravar o cache.
# Supabase → Project Settings → API Keys → Secret keys (começa com sb_secret_)
SUPABASE_SECRET_KEY=

# Só no servidor (NUNCA com prefixo NEXT_PUBLIC_): protege /pros/refresh, a
# renovação diária da lista de pros. Valor aleatório longo (ex.: openssl rand -hex 32).
# Na Vercel, o cron envia sozinho "Authorization: Bearer <valor>".
CRON_SECRET=
